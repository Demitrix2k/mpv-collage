#!/usr/bin/env python3
"""mpv-collage: poster-style collage from a movie, an episode folder or a whole show.

A gapless grid of frames, with the title written in the centre tile. Give it one
video file (frames spread across the film), a season folder (frames drawn from
different episodes) or a show folder (episodes from every season).

    mpv-collage PATH [-t TITLE] [--no-title] [-g CxR] [-w WIDTH] [--gap PX]
                    [--seed N] [--weight thin|regular|bold] [-o OUTPUT]

Variants: change --seed for different frames, -g for another grid (the title
tile is only used when both counts are odd, e.g. 3x3 or 5x3), --gap for a
bordered look, --weight for the title font. Needs ffmpeg and Pillow.
"""
import argparse
import os
import random
import re
import subprocess
import sys
import tempfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

from PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps, ImageStat

VIDEO_EXT = {'.mkv', '.mp4', '.m4v', '.avi', '.mov', '.webm', '.ts', '.wmv'}
SKIP_DIRS = re.compile(r'^(subs?|subtitles?|extras?|featurettes?|samples?|trailers?|specials?|season 0)$', re.I)
CANDIDATES = 6          # frames tried per tile; the most varied one is kept
EDGE = (0.08, 0.92)     # keep clear of intros, credits and end cards


def natural_key(p):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r'(\d+)', str(p))]


def find_videos(path):
    path = Path(path)
    if path.is_file():
        return [path]
    found = []
    for root, dirs, files in os.walk(path):
        dirs[:] = [d for d in dirs if not SKIP_DIRS.match(d)]
        for f in files:
            if Path(f).suffix.lower() in VIDEO_EXT and 'sample' not in f.lower():
                found.append(Path(root) / f)
    return sorted(found, key=natural_key)


def duration(path):
    r = subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration',
                        '-of', 'csv=p=0', str(path)], capture_output=True, text=True)
    try:
        return float(r.stdout.strip())
    except ValueError:
        return 0.0


def clean_title(name):
    name = re.sub(r'\.(mkv|mp4|m4v|avi|mov|webm)$', '', name, flags=re.I)
    name = re.sub(r'[\[(].*?[\])]', ' ', name)
    cut = re.search(r'[ ._-](S\d{1,2}([ ._-]?E\d{1,3})?|Season|Complete|(19|20)\d{2}|\d{3,4}p|BluRay|WEB|HDTV)\b',
                    name, re.I)
    if cut:
        name = name[:cut.start()]
    return re.sub(r'\s+', ' ', re.sub(r'[._]', ' ', name)).strip(' -')


def guess_title(path):
    path = Path(path).resolve()
    for p in [path, *list(path.parents)[:2]]:
        t = clean_title(p.name)
        if len(t) >= 3 and not re.match(r'season\b', t, re.I):
            return t
    return path.stem


def plan_slots(videos, durs, n, rng):
    """One (video, fraction, jitter) per tile: spread over episodes, then over time."""
    e = len(videos)
    slots = []
    if e >= n:
        picks = [round(i * (e - 1) / (n - 1)) for i in range(n)] if n > 1 else [0]
        for v in picks:
            slots.append((videos[v], rng.uniform(0.15, 0.85), 0.06))
    else:
        counts = [n // e] * e
        for i in rng.sample(range(e), n - sum(counts)):
            counts[i] += 1
        for v, c in zip(videos, counts):
            width = (EDGE[1] - EDGE[0]) / c
            for j in range(c):
                slots.append((v, EDGE[0] + width * (j + rng.uniform(0.3, 0.7)), width / 2))
    return slots


def trim_bars(img):
    """Cut flat, near-black letterbox bars off the top and bottom of a frame."""
    g = img.convert('L')
    w, h = g.size
    limit = h // 4

    def is_bar(y):
        lo, hi = g.crop((0, y, w, y + 1)).getextrema()
        return hi < 40 and hi - lo <= 3

    top = 0
    while top < limit and is_bar(top):
        top += 1
    bottom = 0
    while bottom < limit and is_bar(h - 1 - bottom):
        bottom += 1
    if top < h * 0.02 or bottom < h * 0.02:     # real bars come in pairs
        return img
    return img.crop((0, top, w, h - bottom))


def score(img):
    """Prefer varied, sharp, reasonably exposed frames over dark, flat or blurred ones."""
    g = img.convert('L').resize((256, 144))
    st = ImageStat.Stat(g)
    mean, std = st.mean[0], st.stddev[0]
    edges = ImageStat.Stat(g.filter(ImageFilter.FIND_EDGES)).mean[0]
    s = std * (edges + 1)
    return s if 28 < mean < 235 else s * 0.2


_hdr_cache = {}
TONEMAP = ('zscale=t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,tonemap=tonemap=hable:desat=0,'
           'zscale=t=bt709:m=bt709:r=tv,format=yuv420p')


def is_hdr(video):
    if video not in _hdr_cache:
        r = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'v:0', '-show_entries',
                            'stream=color_transfer', '-of', 'csv=p=0', str(video)],
                           capture_output=True, text=True)
        _hdr_cache[video] = r.stdout.strip() in ('smpte2084', 'arib-std-b67')
    return _hdr_cache[video]


def grab(video, dur, frac, jitter, tw, th, rng_seed, tmp):
    rng = random.Random(rng_seed)
    ew = round(tw * 1.35)       # extra width: bar-trimmed wide frames are cropped, so keep detail
    vf = f'scale={ew}:-2'
    if is_hdr(video):
        vf += ',' + TONEMAP
    best, best_score = None, -1.0
    for k in range(CANDIDATES):
        f = min(max(frac + rng.uniform(-jitter, jitter), 0.04), 0.96)
        out = Path(tmp) / f'{rng_seed}-{k}.png'
        subprocess.run(['ffmpeg', '-v', 'error', '-ss', f'{dur * f:.2f}', '-i', str(video),
                        '-an', '-sn', '-frames:v', '1', '-vf', vf, '-y', str(out)],
                       capture_output=True)
        if not out.exists() or out.stat().st_size == 0:
            continue
        img = ImageOps.fit(trim_bars(Image.open(out).convert('RGB')), (tw, th), Image.LANCZOS)
        out.unlink()
        s = score(img)
        if s > best_score:
            best, best_score = img, s
    return best or Image.new('RGB', (tw, th), 'black')


def font_path(weight):
    family = {'thin': 'Open Sans:light', 'regular': 'Open Sans', 'bold': 'Open Sans:bold'}[weight]
    r = subprocess.run(['fc-match', '-f', '%{file}', family], capture_output=True, text=True)
    return r.stdout.strip() or '/usr/share/fonts/TTF/DejaVuSans.ttf'


def title_tile(title, tw, th, weight):
    tile = Image.new('RGB', (tw, th), (0, 0, 0))
    draw = ImageDraw.Draw(tile)
    text = title.upper()
    size = max(10, round(th * 0.065))
    fp = font_path(weight)
    while True:
        font = ImageFont.truetype(fp, size)
        track, word_gap = size * 0.55, size * 1.4
        widths = [[draw.textlength(ch, font=font) for ch in w] for w in text.split(' ')]
        total = sum(sum(ws) + track * (len(ws) - 1) for ws in widths) + word_gap * (len(widths) - 1)
        if total <= tw * 0.82 or size <= 10:
            break
        size -= 1
    x = (tw - total) / 2
    y = th / 2
    for word, ws in zip(text.split(' '), widths):
        for ch, w in zip(word, ws):
            draw.text((x, y), ch, font=font, fill=(228, 228, 228), anchor='lm')
            x += w + track
        x += word_gap - track
    return tile


def main():
    ap = argparse.ArgumentParser(description='Poster-style collage from a movie, season or show.')
    ap.add_argument('path')
    ap.add_argument('-t', '--title')
    ap.add_argument('--no-title', action='store_true')
    ap.add_argument('-g', '--grid', default='3x3')
    ap.add_argument('-w', '--width', type=int, default=2000)
    ap.add_argument('--gap', type=int, default=0)
    ap.add_argument('--seed', type=int, default=0)
    ap.add_argument('--weight', choices=['thin', 'regular', 'bold'], default='thin')
    ap.add_argument('-o', '--output')
    a = ap.parse_args()

    m = re.fullmatch(r'(\d+)[xX](\d+)', a.grid)
    if not m:
        sys.exit('collage: --grid must look like 3x3')
    cols, rows = int(m[1]), int(m[2])
    if not os.path.exists(a.path):
        sys.exit(f'collage: no such path: {a.path}')

    videos = find_videos(a.path)
    if not videos:
        sys.exit('collage: no video files found')
    durs = {v: duration(v) for v in videos}
    if len(videos) > 1:     # drop extras and samples that slipped through
        videos = [v for v in videos if durs[v] >= 300] or videos
    videos = [v for v in videos if durs[v] > 0]
    if not videos:
        sys.exit('collage: could not read any video')

    title = a.title or guess_title(a.path)
    center = (rows // 2) * cols + cols // 2 if cols % 2 and rows % 2 else None
    use_title = center is not None and not a.no_title and bool(title)
    n = cols * rows - (1 if use_title else 0)

    tw = -(-(a.width - a.gap * (cols + 1)) // cols)     # rounded up; the canvas clips the excess
    th = round(tw * 9 / 16)
    rng = random.Random(a.seed)
    slots = plan_slots(videos, durs, n, rng)
    print(f'{title}: {len(videos)} file(s), {n} frames, {cols}x{rows} grid', file=sys.stderr)

    with tempfile.TemporaryDirectory() as tmp, ThreadPoolExecutor(os.cpu_count() or 4) as pool:
        futs = [pool.submit(grab, v, durs[v], f, j, tw, th, a.seed * 1000 + i, tmp)
                for i, (v, f, j) in enumerate(slots)]
        frames = [f.result() for f in futs]

    canvas = Image.new('RGB', (a.width, rows * th + a.gap * (rows + 1)), 'black')
    it = iter(frames)
    for r in range(rows):
        for c in range(cols):
            idx = r * cols + c
            tile = title_tile(title, tw, th, a.weight) if use_title and idx == center else next(it)
            canvas.paste(tile, (a.gap + c * (tw + a.gap), a.gap + r * (th + a.gap)))

    if a.output:
        out = Path(a.output)
    else:
        outdir = Path.home() / 'Pictures' / 'mpv'
        outdir.mkdir(parents=True, exist_ok=True)
        stem = re.sub(r'[^\w .-]+', '', title).strip() or 'collage'
        out = outdir / f'{stem}-collage{f"-seed{a.seed}" if a.seed else ""}.jpg'
    canvas.save(out, quality=92, subsampling=0)
    print(out)


if __name__ == '__main__':
    main()
